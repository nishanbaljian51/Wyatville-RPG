public class Game{
  
   public static void wait(int x){
       try {
           Thread.sleep(x*1000);
       }
       catch (InterruptedException e){
           return;
       }
   }

   public static void clear(int x){
       try {
           Thread.sleep(x*1000);
       }
       catch (InterruptedException e){
           System.out.flush();
       }
   }

   public static void printNWait(String str){
       System.out.println(str);
       Game.wait(str.length()/6);
   }

   public static String getStringResponse(){
       Scanner scName = new Scanner(System.in);
       String name = scName.nextLine();
       return name;
  }

  public static int getIntResponse(){
       Scanner scInt = new Scanner(System.in);
       int num = scInt.nextInt();
       return num;
  }

  public static int getSpecificIntResponse(int min, int max, int numTimes){
       if (min == max){
            return 0;
       }
       if (numTimes <= 0){
           return -1;
       }
       Scanner sc = new Scanner(System.in);
       int next = sc.nextInt();
       if (next >= min && next <= max){
           return next;
       }
       else{
           System.out.println("Sorry I didn't get that. Can you type it again (Use only 'Yes' or 'No'):");
           return getSpecificIntResponse(min, max, numTimes-1);
       }
  }

   public static String getYesOrNoResponse(int numTimes){
       if (numTimes <= 0){
           return "";
       }
       Scanner sc = new Scanner(System.in);
       String next = sc.nextLine().toLowerCase();
       if (next.equals("yes") || next.equals("no")){
           return next;
       }
       else{
           System.out.println("Sorry I didn't get that. Can you type it again (Use only 'Yes' or 'No'):");
           return getYesOrNoResponse(numTimes-1);
       }
  }

   public static String getSpecificResponse(String str1, String str2, String str3, int numTimes){
       if (numTimes <= 0){
           return "";
       }
       Scanner sc = new Scanner(System.in);
       String next = sc.nextLine().toLowerCase();
       if (next.equals(str1) || next.equals(str2) || next.equals(str3)){
           return next;
       }
       else{
           System.out.println("Sorry I didn't get that. Can you type it again (Use only 'Yes' or 'No'):");
           return getSpecificResponse(str1, str2, str3, numTimes-1);
       }
  }
  
   public static String getSpecificResponse(String str1, String str2, int numTimes){
       if (numTimes <= 0){
           return "";
       }
       Scanner sc = new Scanner(System.in);
       String next = sc.nextLine().toLowerCase();
       if (next.equals(str1) || next.equals(str2)){
           return next;
       }
       else{
           System.out.println("Sorry I didn't get that. Can you type it again (Use only 'Yes' or 'No'):");
           return getSpecificResponse(str1, str2, numTimes-1);
       }
  }


  public static String getSpecificResponse(String str1, int numTimes){
       if (numTimes <= 0){
           return "";
       }
       Scanner sc = new Scanner(System.in);
       String next = sc.nextLine().toLowerCase();
       if (next.equals(str1)){
           return next;
       }
       else{
           System.out.println("Sorry I didn't get that. Can you type it again (Use only 'Yes' or 'No'):");
           return getResponse(str1, numTimes-1);
       }
  }
}
